define(['N/log', 'N/cache', 'N/query'], function(log, cache, query) {
    
    /**
     * Generate a UUID v4
     * @returns {string} UUID string
     */
    function uuidv4() {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
            var r = Math.random() * 16 | 0;
            var v = c === 'x' ? r : (r & 0x3 | 0x8);
            return v.toString(16);
        });
    }
    
    /**
     * Check if a checkbox field value is true
     * NetSuite checkbox fields can return 'T'/'F' strings OR true/false booleans
     * @param {string|boolean} value - The checkbox field value
     * @returns {boolean} True if checked
     */
    function isCheckboxTrue(value) {
        return value === 'T' || value === true;
    }
    
    /**
     * Escape SQL special characters for safe query building
     * @param {string} str - String to escape
     * @returns {string} Escaped string
     */
    function escapeSql(str) {
        if (!str) return '';
        return str.replace(/'/g, "''");
    }
    
    /**
     * Get cached data or execute loader function
     * @param {string} key - Cache key
     * @param {Function} loaderFn - Function to call if cache miss
     * @param {number} ttl - Time to live in seconds (default 3600 = 1 hour)
     * @returns {*} Cached or fresh data
     */
    function getCached(key, loaderFn, ttl) {
        ttl = ttl || 3600;
        
        try {
            const cacheInstance = cache.getCache({
                name: '{PREFIX}Cache',
                scope: cache.Scope.PUBLIC
            });
            
            const cached = cacheInstance.get({
                key: key,
                loader: function() {
                    const result = loaderFn();
                    return JSON.stringify(result);
                },
                ttl: ttl
            });
            
            return JSON.parse(cached);
            
        } catch (error) {
            log.error('getCached Error', {
                key: key,
                error: error.message
            });
            
            // Fall back to direct execution
            return loaderFn();
        }
    }
    
    /**
     * Fetch records with pagination for large result sets
     * @param {string} sql - SQL query to execute
     * @param {number} pageSize - Records per page (default 1000)
     * @returns {Array} All results combined
     */
    function fetchWithPagination(sql, pageSize) {
        pageSize = pageSize || 1000;
        const allResults = [];
        let offset = 0;
        let hasMore = true;
        
        while (hasMore) {
            const pagedSql = sql + ' OFFSET ' + offset + ' ROWS FETCH NEXT ' + pageSize + ' ROWS ONLY';
            
            try {
                const results = query.runSuiteQL({ query: pagedSql }).asMappedResults();
                
                if (results.length === 0) {
                    hasMore = false;
                } else {
                    allResults.push.apply(allResults, results);
                    offset += pageSize;
                    
                    if (results.length < pageSize) {
                        hasMore = false;
                    }
                }
            } catch (error) {
                log.error('fetchWithPagination Error', {
                    sql: pagedSql,
                    error: error.message
                });
                hasMore = false;
            }
        }
        
        return allResults;
    }
    
    /**
     * Fetch data in batches (for IN clause limits)
     * @param {Array} ids - Array of IDs to process
     * @param {Function} fetchFn - Function that takes batch of IDs and returns results
     * @param {number} batchSize - Size of each batch (default 500)
     * @returns {Array} All results combined
     */
    function fetchInBatches(ids, fetchFn, batchSize) {
        batchSize = batchSize || 500;
        const allResults = [];
        
        for (var i = 0; i < ids.length; i += batchSize) {
            const batchIds = ids.slice(i, i + batchSize);
            
            try {
                const batchResults = fetchFn(batchIds);
                allResults.push.apply(allResults, batchResults);
            } catch (error) {
                log.error('fetchInBatches Error', {
                    batchStart: i,
                    batchSize: batchIds.length,
                    error: error.message
                });
            }
        }
        
        return allResults;
    }
    
    /**
     * Safe JSON parse with default value
     * @param {string} str - JSON string to parse
     * @param {*} defaultValue - Default value if parse fails
     * @returns {*} Parsed object or default value
     */
    function safeJsonParse(str, defaultValue) {
        defaultValue = defaultValue || null;
        
        if (!str) return defaultValue;
        
        try {
            return JSON.parse(str);
        } catch (error) {
            log.debug('safeJsonParse', 'Failed to parse JSON: ' + error.message);
            return defaultValue;
        }
    }
    
    /**
     * Format date for SuiteQL queries
     * @param {Date|string} date - Date to format
     * @param {string} format - Format pattern (default 'YYYY-MM-DD')
     * @returns {string} Formatted date string
     */
    function formatDateForSql(date, format) {
        format = format || 'YYYY-MM-DD';
        
        if (!date) return null;
        
        const d = typeof date === 'string' ? new Date(date) : date;
        
        if (isNaN(d.getTime())) return null;
        
        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        const hours = String(d.getHours()).padStart(2, '0');
        const minutes = String(d.getMinutes()).padStart(2, '0');
        const seconds = String(d.getSeconds()).padStart(2, '0');
        
        return format
            .replace('YYYY', year)
            .replace('MM', month)
            .replace('DD', day)
            .replace('HH', hours)
            .replace('mm', minutes)
            .replace('ss', seconds);
    }
    
