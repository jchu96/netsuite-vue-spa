    return {
        uuidv4: uuidv4,
        isCheckboxTrue: isCheckboxTrue,
        escapeSql: escapeSql,
        getCached: getCached,
        fetchWithPagination: fetchWithPagination,
        fetchInBatches: fetchInBatches,
        safeJsonParse: safeJsonParse,
        formatDateForSql: formatDateForSql,
        addAuditEntry: addAuditEntry
    };
});

