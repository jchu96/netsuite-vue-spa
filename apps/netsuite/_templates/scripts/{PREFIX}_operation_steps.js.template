/**
 * @NApiVersion 2.1
 * @NModuleScope SameAccount
 * 
 * {PROJECT_NAME} Operation Step Definitions
 * Centralized source of truth for all long-running operation steps
 * Add/remove/reorder steps here - frontend automatically adapts
 */

define([], function() {
    
    /**
     * Step definitions for each operation type
     * Each step has:
     * - id: Stable identifier (used in switch statements)
     * - message: User-friendly description shown in UI
     * 
     * Customize these for your project's specific operations.
     */
    const OPERATION_STEPS = {
        // Example: Data import operation
        // Replace with your actual operation types
        'data_import': [
            {
                id: 'validate',
                message: 'Validating input data and permissions'
            },
            {
                id: 'fetch',
                message: 'Fetching source records'
            },
            {
                id: 'transform',
                message: 'Transforming data format'
            },
            {
                id: 'create',
                message: 'Creating target records'
            },
            {
                id: 'finalize',
                message: 'Finalizing import and cleanup'
            }
        ],
        
        // Example: Record sync operation
        'record_sync': [
            {
                id: 'connect',
                message: 'Connecting to external system'
            },
            {
                id: 'compare',
                message: 'Comparing record sets'
            },
            {
                id: 'update',
                message: 'Updating changed records'
            },
            {
                id: 'cleanup',
                message: 'Cleaning up and finalizing'
            }
        ],
        
        // Example: Batch processing operation
        'batch_process': [
            {
                id: 'load',
                message: 'Loading records for processing'
            },
            {
                id: 'validate',
                message: 'Validating record data'
            },
            {
                id: 'process',
                message: 'Processing records'
            },
            {
                id: 'notify',
                message: 'Sending notifications'
            }
        ]
        
        // Add your operation types here...
    };
    
    /**
     * Get step definitions for an operation type
     * @param {string} operationType - Operation type key from OPERATION_STEPS
     * @returns {Array<{id: string, message: string}>} Array of step definitions
     */
    function getStepsForOperation(operationType) {
        return OPERATION_STEPS[operationType] || [];
    }
    
    /**
     * Initialize progress steps array from definitions
     * Creates the initial progress data structure for tracking
     * @param {string} operationType - Operation type key
     * @returns {Array<Object>} Array of step objects with metadata
     */
    function initializeSteps(operationType) {
        const stepDefinitions = getStepsForOperation(operationType);
        
        return stepDefinitions.map(function(def, index) {
            return {
                id: def.id,
                step: index + 1,
                message: def.message,
                completed: false,
                timestamp: new Date().toISOString()
            };
        });
    }
    
    /**
     * Get total step count for an operation
     * @param {string} operationType - Operation type key
     * @returns {number} Number of steps
     */
    function getStepCount(operationType) {
        return getStepsForOperation(operationType).length;
    }
    
    /**
     * Validate operation type exists
     * @param {string} operationType - Operation type to validate
     * @returns {boolean} True if operation type is defined
     */
    function isValidOperationType(operationType) {
        return OPERATION_STEPS.hasOwnProperty(operationType);
    }
    
    /**
     * Get all available operation types
     * @returns {string[]} Array of operation type keys
     */
    function getOperationTypes() {
        return Object.keys(OPERATION_STEPS);
    }
    
    return {
        OPERATION_STEPS: OPERATION_STEPS,
        getStepsForOperation: getStepsForOperation,
        initializeSteps: initializeSteps,
        getStepCount: getStepCount,
        isValidOperationType: isValidOperationType,
        getOperationTypes: getOperationTypes
    };
});

