# LocalStorage Caching Patterns

## Basic Cache Pattern with TTL

```typescript
const CACHE_KEY = 'dp_classifications'
const CACHE_TIME_KEY = 'dp_classifications_time'
const CACHE_TTL_MS = 24 * 60 * 60 * 1000 // 24 hours

async fetchClassifications(forceRefresh = false) {
  // Check cache first (unless force refresh)
  if (!forceRefresh) {
    const cached = localStorage.getItem(CACHE_KEY)
    const cacheTime = localStorage.getItem(CACHE_TIME_KEY)
    
    if (cached && cacheTime) {
      const age = Date.now() - parseInt(cacheTime)
      if (age < CACHE_TTL_MS) {
        // Cache is valid
        this.classifications = JSON.parse(cached)
        return
      }
    }
  }
  
  // Fetch fresh data
  const response = await api.getClassifications()
  this.classifications = response.data
  
  // Update cache
  localStorage.setItem(CACHE_KEY, JSON.stringify(this.classifications))
  localStorage.setItem(CACHE_TIME_KEY, Date.now().toString())
}
```

## Cache Key Naming Convention

Use a consistent prefix for your app:

```typescript
// ✅ CORRECT - Prefixed, descriptive keys
const CACHE_KEYS = {
  CLASSIFICATIONS: 'dp_classifications',
  CLASSIFICATIONS_TIME: 'dp_classifications_time',
  LOCATIONS: 'dp_locations',
  LOCATIONS_TIME: 'dp_locations_time',
  USER_PREFERENCES: 'dp_user_prefs',
}

// ❌ WRONG - Generic keys that may conflict
const keys = {
  data: 'data',
  cache: 'cache',
}
```

## Reusable Cache Helper

```typescript
// utils/cacheHelper.ts

interface CacheOptions {
  key: string
  ttlMs?: number
}

const DEFAULT_TTL = 24 * 60 * 60 * 1000 // 24 hours

export function getCached<T>(options: CacheOptions): T | null {
  const { key, ttlMs = DEFAULT_TTL } = options
  
  try {
    const cached = localStorage.getItem(key)
    const cacheTime = localStorage.getItem(`${key}_time`)
    
    if (!cached || !cacheTime) return null
    
    const age = Date.now() - parseInt(cacheTime)
    if (age >= ttlMs) {
      // Cache expired - clear it
      clearCache(key)
      return null
    }
    
    return JSON.parse(cached) as T
  } catch (err) {
    console.warn(`Cache read error for ${key}:`, err)
    clearCache(key)
    return null
  }
}

export function setCache<T>(key: string, data: T): void {
  try {
    localStorage.setItem(key, JSON.stringify(data))
    localStorage.setItem(`${key}_time`, Date.now().toString())
  } catch (err) {
    console.warn(`Cache write error for ${key}:`, err)
    // Handle quota exceeded
    if (err instanceof DOMException && err.name === 'QuotaExceededError') {
      clearAllAppCache()
    }
  }
}

export function clearCache(key: string): void {
  localStorage.removeItem(key)
  localStorage.removeItem(`${key}_time`)
}

export function clearAllAppCache(): void {
  const appPrefix = 'dp_'
  const keysToRemove: string[] = []
  
  for (let i = 0; i < localStorage.length; i++) {
    const key = localStorage.key(i)
    if (key?.startsWith(appPrefix)) {
      keysToRemove.push(key)
    }
  }
  
  keysToRemove.forEach(key => localStorage.removeItem(key))
}
```

## Usage in Pinia Store

```typescript
import { getCached, setCache, clearCache } from '../utils/cacheHelper'

export const useClassificationStore = defineStore('classification', {
  state: () => ({
    classifications: [] as Classification[],
    loading: false,
  }),
  
  actions: {
    async fetchClassifications(forceRefresh = false) {
      // Try cache first
      if (!forceRefresh) {
        const cached = getCached<Classification[]>({
          key: 'dp_classifications',
          ttlMs: 24 * 60 * 60 * 1000
        })
        
        if (cached) {
          this.classifications = cached
          return
        }
      }
      
      // Fetch from API
      this.loading = true
      try {
        const response = await api.getClassifications()
        this.classifications = response.data
        
        // Cache the result
        setCache('dp_classifications', this.classifications)
      } finally {
        this.loading = false
      }
    },
    
    invalidateCache() {
      clearCache('dp_classifications')
    },
  },
})
```

## Cache Invalidation Strategies

### 1. Time-Based (TTL)
```typescript
// Cache expires after set time
const ttlMs = 24 * 60 * 60 * 1000 // 24 hours
```

### 2. User Action Invalidation
```typescript
// Clear cache when user modifies data
async saveClassification(data: Classification) {
  await api.save(data)
  this.invalidateCache()  // Clear cache
  await this.fetchClassifications(true)  // Force refresh
}
```

### 3. Version-Based Invalidation
```typescript
const CACHE_VERSION = 'v2'
const CACHE_KEY = `dp_classifications_${CACHE_VERSION}`

// Old cache keys automatically ignored when version changes
```

### 4. Session-Based (Clear on Logout)
```typescript
// In auth/logout handler
const logout = () => {
  clearAllAppCache()
  // ... other logout logic
}
```

## Common TTL Values

| Data Type | TTL | Reasoning |
|-----------|-----|-----------|
| Reference data (classifications, statuses) | 24 hours | Changes rarely |
| User preferences | No TTL (persist) | User-controlled |
| List data (items, orders) | 5-15 minutes | Changes frequently |
| Session data | Session only | Security |

## Error Handling

```typescript
export function safeCacheRead<T>(key: string, defaultValue: T): T {
  try {
    const cached = localStorage.getItem(key)
    return cached ? JSON.parse(cached) : defaultValue
  } catch {
    // Invalid JSON or other error
    localStorage.removeItem(key)
    return defaultValue
  }
}

export function safeCacheWrite(key: string, data: unknown): boolean {
  try {
    localStorage.setItem(key, JSON.stringify(data))
    return true
  } catch (err) {
    if (err instanceof DOMException) {
      if (err.name === 'QuotaExceededError') {
        console.warn('LocalStorage quota exceeded')
        // Try to clear old cache and retry
        clearAllAppCache()
        try {
          localStorage.setItem(key, JSON.stringify(data))
          return true
        } catch {
          return false
        }
      }
    }
    return false
  }
}
```

## Best Practices

1. **Always use try/catch** - localStorage can throw (quota, private mode)
2. **Use a consistent prefix** - Prevents key collisions (`dp_`, `app_`)
3. **Store timestamps separately** - Makes TTL checks cleaner
4. **Provide force refresh option** - Users should be able to bypass cache
5. **Clear cache on mutations** - After create/update/delete operations
6. **Don't cache sensitive data** - No tokens, passwords, PII
7. **Keep payloads small** - localStorage limit is ~5-10MB total
8. **Log cache events in dev** - Helps debugging stale data issues
