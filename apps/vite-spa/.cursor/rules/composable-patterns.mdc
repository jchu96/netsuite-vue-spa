# Composable Structure Patterns

## Naming Convention

- File: `useCamelCase.ts` (always prefixed with `use`)
- Function: `export function useCamelCase()`
- Location: `src/composables/`

## Basic Composable Template

```typescript
// composables/useMyFeature.ts

import { ref, computed, watch, onMounted, onUnmounted, type Ref, type ComputedRef } from 'vue'

interface UseMyFeatureOptions {
  immediate?: boolean
  debounceMs?: number
}

interface UseMyFeatureReturn {
  data: Ref<MyData | null>
  loading: Ref<boolean>
  error: Ref<string | null>
  computed: ComputedRef<number>
  fetch: () => Promise<void>
  reset: () => void
}

/**
 * Composable for handling [feature description]
 * 
 * @param input - Reactive input parameter
 * @param options - Configuration options
 * @returns Reactive state and methods
 */
export function useMyFeature(
  input: Ref<string>,
  options: UseMyFeatureOptions = {}
): UseMyFeatureReturn {
  const { immediate = false, debounceMs = 300 } = options
  
  // State
  const data = ref<MyData | null>(null)
  const loading = ref(false)
  const error = ref<string | null>(null)
  
  // Computed
  const computedValue = computed(() => {
    return data.value?.items.length ?? 0
  })
  
  // Methods
  const fetch = async (): Promise<void> => {
    loading.value = true
    error.value = null
    
    try {
      // ... fetch logic
    } catch (err: unknown) {
      error.value = err instanceof Error ? err.message : 'Unknown error'
    } finally {
      loading.value = false
    }
  }
  
  const reset = (): void => {
    data.value = null
    error.value = null
  }
  
  // Lifecycle
  onMounted(() => {
    if (immediate) {
      fetch()
    }
  })
  
  // Watchers (if needed)
  watch(input, () => {
    fetch()
  }, { debounce: debounceMs })
  
  // Return public API
  return {
    data,
    loading,
    error,
    computed: computedValue,
    fetch,
    reset,
  }
}
```

## Composable with Cleanup

```typescript
export function useInterval(callback: () => void, ms: number) {
  const isActive = ref(true)
  let intervalId: ReturnType<typeof setInterval> | null = null
  
  const start = () => {
    if (intervalId) return
    intervalId = setInterval(callback, ms)
    isActive.value = true
  }
  
  const stop = () => {
    if (intervalId) {
      clearInterval(intervalId)
      intervalId = null
    }
    isActive.value = false
  }
  
  // Auto-cleanup on component unmount
  onUnmounted(() => {
    stop()
  })
  
  // Auto-start
  start()
  
  return { isActive, start, stop }
}
```

## Composable Accepting Refs vs Values

```typescript
// Accept both Ref<T> and T using MaybeRef
import { type MaybeRef, toRef, unref } from 'vue'

export function useFeature(input: MaybeRef<string>) {
  // Convert to ref if it's a plain value
  const inputRef = toRef(input)
  
  // Use unref() when you need the raw value
  const process = () => {
    const value = unref(inputRef)
    // ...
  }
  
  // Watch works with refs
  watch(inputRef, () => {
    process()
  })
}

// Usage - both work:
useFeature('static-value')
useFeature(ref('reactive-value'))
useFeature(computed(() => props.value))
```

## Composable with External Data Dependencies

```typescript
// When composable needs reactive props data
export function useDataProcessor(
  sourceData: Ref<SourceItem[] | null>,
  config: Ref<ProcessConfig>
) {
  // Computed reacts to source changes
  const processedData = computed(() => {
    if (!sourceData.value) return []
    
    return sourceData.value.map(item => ({
      ...item,
      processed: applyConfig(item, config.value)
    }))
  })
  
  const totals = computed(() => {
    return processedData.value.reduce((sum, item) => sum + item.value, 0)
  })
  
  return {
    processedData,
    totals,
  }
}

// In component:
const sourceData = computed(() => props.items)
const config = computed(() => props.config)

const { processedData, totals } = useDataProcessor(sourceData, config)
```

## Composable Patterns to Avoid

### ❌ Don't Return Non-Reactive Values

```typescript
// ❌ WRONG - Returning primitive loses reactivity
export function useCounter() {
  const count = ref(0)
  return {
    count: count.value,  // This is NOT reactive!
    increment: () => count.value++
  }
}

// ✅ CORRECT - Return the ref itself
export function useCounter() {
  const count = ref(0)
  return {
    count,  // Reactive ref
    increment: () => count.value++
  }
}
```

### ❌ Don't Destructure Refs in Return

```typescript
// ❌ WRONG - Destructuring loses reactivity
const { value } = count
return { value }

// ✅ CORRECT - Return ref directly
return { count }
```

### ❌ Don't Forget Cleanup

```typescript
// ❌ WRONG - Timer leaks on component unmount
export function useAutoSave() {
  setInterval(() => save(), 5000)  // Never cleaned up!
}

// ✅ CORRECT - Clean up in onUnmounted
export function useAutoSave() {
  const intervalId = setInterval(() => save(), 5000)
  
  onUnmounted(() => {
    clearInterval(intervalId)
  })
}
```

## When to Create a Composable

Create a composable when:
1. **Logic is reused** across multiple components
2. **Complex reactive logic** that clutters components
3. **Encapsulating side effects** (timers, subscriptions, API calls)
4. **Stateful logic** that needs lifecycle management

Don't create a composable for:
1. **Simple one-liner computations** - use inline computed
2. **Non-reactive utilities** - use plain functions in `/utils/`
3. **Component-specific logic** that won't be reused

## Testing Composables

```typescript
import { ref } from 'vue'
import { useMyFeature } from './useMyFeature'

describe('useMyFeature', () => {
  it('should initialize with default values', () => {
    const input = ref('test')
    const { data, loading, error } = useMyFeature(input)
    
    expect(data.value).toBe(null)
    expect(loading.value).toBe(false)
    expect(error.value).toBe(null)
  })
})
```
