# API Error Handling Patterns

## Standard Try/Catch Pattern

**Every API call must follow this pattern:**

```typescript
const isLoading = ref(false)
const error = ref<string | null>(null)

const fetchData = async () => {
  isLoading.value = true
  error.value = null
  
  try {
    const response = await api.getData()
    
    if (!response.success) {
      throw new Error(response.error?.message || 'Request failed')
    }
    
    // Process successful response
    data.value = response.data
    
  } catch (err: unknown) {
    const message = err instanceof Error ? err.message : 'An unexpected error occurred'
    error.value = message
    console.error('API Error:', err)
  } finally {
    isLoading.value = false
  }
}
```

## Toast Notifications

### Success/Error Feedback in Components

```typescript
import { useToast } from 'primevue/usetoast'

const toast = useToast()

const saveItem = async () => {
  isSaving.value = true
  
  try {
    await api.save(item)
    
    toast.add({
      severity: 'success',
      summary: 'Saved',
      detail: 'Item saved successfully',
      life: 3000
    })
    
  } catch (err: unknown) {
    const message = err instanceof Error ? err.message : 'Save failed'
    
    toast.add({
      severity: 'error',
      summary: 'Error',
      detail: message,
      life: 5000
    })
  } finally {
    isSaving.value = false
  }
}
```

### Toast Severity Levels

| Severity | Use Case | Life (ms) |
|----------|----------|-----------|
| `success` | Action completed | 3000 |
| `info` | Informational notice | 3000 |
| `warn` | Warning, action needed | 5000 |
| `error` | Operation failed | 5000-7000 |

## Store Action Pattern

**Stores should NOT show toasts directly.** Set state and let components react:

```typescript
// ✅ CORRECT - Store sets state only
actions: {
  async fetchUsers(): Promise<void> {
    this.loading = true
    this.error = null
    
    try {
      const response = await this._api.getUsers()
      
      if (!response.success) {
        throw new Error(response.error?.message || 'Failed to fetch users')
      }
      
      this.users = response.data
      
    } catch (err: unknown) {
      this.error = err instanceof Error ? err.message : 'Unknown error'
      console.error('Store error:', err)
    } finally {
      this.loading = false
    }
  }
}

// ✅ CORRECT - Component watches and shows toast
watch(() => userStore.error, (newError) => {
  if (newError) {
    toast.add({
      severity: 'error',
      summary: 'Error',
      detail: newError,
      life: 5000
    })
  }
})
```

## API Response Validation

### Always Check Response Success

```typescript
// ✅ CORRECT - Check success before using data
const response: APIResponse<User[]> = await api.getUsers()

if (!response.success) {
  throw new Error(response.error?.message || 'Request failed')
}

// Safe to use response.data here
this.users = response.data

// ❌ WRONG - Assuming success
const response = await api.getUsers()
this.users = response.data  // May be undefined if success is false!
```

### Handle Empty Data vs Error

```typescript
if (!response.success) {
  // Actual error occurred
  throw new Error(response.error?.message)
}

if (!response.data || response.data.length === 0) {
  // Success but no data - not an error, just empty state
  this.items = []
  return
}

this.items = response.data
```

## Network Error Handling

```typescript
try {
  const response = await fetch(url)
  
  if (!response.ok) {
    // HTTP error (4xx, 5xx)
    throw new Error(`HTTP ${response.status}: ${response.statusText}`)
  }
  
  const data = await response.json()
  // ... process data
  
} catch (err: unknown) {
  if (err instanceof TypeError) {
    // Network error (no connection, CORS, etc.)
    error.value = 'Network error. Please check your connection.'
  } else {
    error.value = err instanceof Error ? err.message : 'Unknown error'
  }
}
```

## Retry Logic Pattern

```typescript
const MAX_RETRIES = 3
const RETRY_DELAY = 1000

const fetchWithRetry = async <T>(
  fn: () => Promise<T>,
  retries = MAX_RETRIES
): Promise<T> => {
  try {
    return await fn()
  } catch (err) {
    if (retries > 0) {
      await new Promise(r => setTimeout(r, RETRY_DELAY))
      return fetchWithRetry(fn, retries - 1)
    }
    throw err
  }
}

// Usage
const data = await fetchWithRetry(() => api.getData())
```

## Error State Reset

**Always reset error state before new requests:**

```typescript
// ✅ CORRECT - Reset at start of action
const fetchData = async () => {
  error.value = null  // Clear previous error
  loading.value = true
  
  try {
    // ...
  } catch (err) {
    error.value = // ...
  }
}

// ❌ WRONG - Error persists from previous request
const fetchData = async () => {
  loading.value = true
  // Previous error still showing!
  
  try {
    // ...
  }
}
```

## Best Practices

1. **Never silently fail** - Always log errors to console and show user feedback
2. **Use specific error messages** - "Failed to save item" not "Error"
3. **Include context in logs** - `console.error('fetchUsers failed:', err)`
4. **Reset loading state in finally** - Ensures cleanup even on error
5. **Type errors as unknown** - Use `catch (err: unknown)` and narrow with instanceof
