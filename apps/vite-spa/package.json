{
  "name": "netsuite-vue-spa-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"vite\" \"node server/index.cjs\"",
    "build": "vue-tsc --noEmit && vite build && node scripts/copy-to-sdf.mjs",
    "test": "vitest run",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "pinia": "3.0.3",
    "primevue": "4.2.5",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.6",
    "concurrently": "9.2.4",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "jsdom": "27.4.0",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.0",
    "vue-tsc": "3.0.6"
  },
  "type": "module"
}
