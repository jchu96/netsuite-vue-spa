# Safe local demo: synthetic values below are never sent to NetSuite.
NETSUITE_MODE=demo
NETSUITE_ACCOUNT=1234567-sb1
NETSUITE_ACCOUNT_REALM=1234567_SB1
TBA_CONSUMER_KEY=example-consumer-key
TBA_CONSUMER_SECRET=example-consumer-secret
TBA_TOKEN_KEY=example-token-key
TBA_TOKEN_SECRET=example-token-secret
# Only these two VITE_ variables are allowed. Both are PUBLIC.
VITE_RESTLET_URL=/app/site/hosting/restlet.nl?script=customscript_nvs_hello_rl&deploy=customdeploy_nvs_hello_rl
VITE_API_SERVER_PORT=3333
# Fixed browser origin is http://127.0.0.1:5173. Open that exact URL.
